# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Google OAuth / Gmail API ---
# Create these in Google Cloud Console (APIs & Services > Credentials).
# See README.md "Gmail / OAuth Setup" for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Session encryption ---
# Any random string, 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Anthropic (AI assistant) ---
ANTHROPIC_API_KEY=

# --- Real-time sync (optional — see README "Real-Time Synchronization") ---
# Only needed if you want real Gmail push notifications (Pub/Sub) instead of
# the built-in polling+SSE fallback. Leave blank to use the fallback.
GOOGLE_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# Base URL the app is reachable at (used to build the Pub/Sub webhook URL).
APP_BASE_URL=http://localhost:3000

# --- Development-only local AI provider (never used in production) ---
# Lets you test the assistant pipeline against a local Ollama model instead
# of Anthropic, at zero API cost. Ignored entirely when NODE_ENV=production
# — Anthropic is always the production provider regardless of this value.
# See README "AI assistant architecture" for setup and model requirements
# (the model must support tool/function calling).
AI_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
